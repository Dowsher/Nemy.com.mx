# Seeed Studio XIAO ESP32-S3 / Sense: onboard USER_LED, active low.
# Confirm the physical board and flash size with esptool before flashing.
# https://wiki.seeedstudio.com/xiao_esp32s3_getting_started/
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-xiao.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PIPALAB_LED_GPIO=21
CONFIG_PIPALAB_LED_SIMPLE=y
CONFIG_PIPALAB_LED_ACTIVE_LOW=y
