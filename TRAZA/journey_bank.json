        35,
        50
      ],
      "form_ids": [
        "PCPTSD5",
        "PHQ9",
        "GAD7",
        "APOYOS",
        "ITQ",
        "MSPSS",
        "LEC5",
        "DEST",
        "ASRS6",
        "BRSCL",
        "ECR12CL"
      ],
      "conditional_forms": [
        {
          "id": "SOCRATES8A",
