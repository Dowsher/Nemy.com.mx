  "routes": [
    {
      "id": "basico",
      "name": "Básico",
      "description": "Un primer recorrido por tus experiencias, reacciones, ánimo, ansiedad y apoyos.",
      "minutes": [
        10,
        15
      ],
      "form_ids": [
        "PCPTSD5",
        "PHQ9",
        "GAD7",
        "APOYOS"
      ],
      "conditional_forms": []
    },
    {
      "id": "intermedio",
      "name": "Intermedio",
      "description": "Amplía el recorrido con síntomas de estrés, impacto cotidiano y apoyo social.",
      "minutes": [
        20,
        30
      ],
      "form_ids": [
        "PCPTSD5",
        "PHQ9",
        "GAD7",
        "APOYOS",
        "ITQ",
        "MSPSS"
      ],
      "conditional_forms": []
    },
    {
      "id": "completo",
